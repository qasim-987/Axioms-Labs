# Axiom Studio Standalone Back-End Configuration
PORT=4000
HOST="0.0.0.0"
NODE_ENV="development"

# Allowed Front-End Origins (comma-separated, "*" allowed in cloud preview)
CORS_ALLOWED_ORIGINS="*"

# Optional Downstream Transactional Delivery (Server-Only)
RESEND_API_KEY=""
CONTACT_NOTIFICATION_EMAIL="contact@axiomstudio.agency"
CONTACT_WEBHOOK_URL=""

# Optional Supabase Persistence (Server-Only Service Key)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
