# Axiom Studio Standalone Back-End Configuration
PORT=4000
HOST="0.0.0.0"
NODE_ENV="development"

# Allowed Front-End Origins (comma-separated, "*" allowed in cloud preview)
CORS_ALLOWED_ORIGINS="*"

# Optional Downstream Transactional Delivery (Server-Only)
RESEND_API_KEY=""
CONTACT_NOTIFICATION_EMAIL="contact@axiomstudio.agency"
CONTACT_WEBHOOK_URL=""

# Optional Supabase Persistence (Server-Only Service Key)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Required with RESEND_API_KEY: verified sender, never onboarding@resend.dev
CONTACT_FROM_EMAIL=""
# Exact trusted proxy IPs/CIDRs, comma-separated. Empty = trust none.
# Set from your hosting provider's documented network topology, not arbitrary client headers.
TRUST_PROXY=""
# Mount a private persistent volume here if retaining the local audit ledger.
# Production success additionally requires email, webhook, or database acceptance.
INQUIRY_DATA_DIR=""

# Durable mode: apply migrations/001_inquiry_outbox.sql before setting Supabase credentials.
# Schedule `npm run worker:outbox` once per minute on the backend host, after build.
# Worker and API use the same server-only configuration. Never expose the worker publicly.
